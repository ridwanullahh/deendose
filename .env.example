# ============================================================
# DeenDose - Environment Variables (example)
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---- Admin credentials (env-based, required) ----
# Used by /admin/login to authenticate the platform administrator.
# In production the password MUST be a bcrypt hash. The runtime
# compares the submitted password against this hash. A plaintext
# password will be rejected in production mode.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH_OF_YOUR_PASSWORD

# Optional: AES-256-GCM key (32 bytes base64) for encrypting OAuth
# tokens at rest in Lightbase. If empty, tokens are stored hashed-only
# (no decryptable social-media publishing).
ADMIN_TOKEN_SECRET=replace-with-32-byte-base64-secret

# ---- Lightbase DB (production backend, required) ----
# When LIGHTBASE_API_KEY is non-empty, the SDK uses Lightbase as the
# primary data backend. When empty, the SDK falls back to GitHub JSON
# storage (local dev only — NEVER use in production).
LIGHTBASE_API_KEY=lb_live_replace_with_real_key
LIGHTBASE_BASE_URL=http://lightbase.80.225.189.74.sslip.io
LIGHTBASE_PROJECT=deendose
LIGHTBASE_TENANT=default

# ---- GitHub DB (local dev fallback only) ----
# Used only when LIGHTBASE_API_KEY is empty. Stores JSON files in this
# repo's /db folder via the GitHub Contents API.
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=ridwanullahh
GITHUB_REPO=deendose
GITHUB_BRANCH=main

# ---- Cloudinary (image generation for daily posts) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-upload-preset
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- SMTP (transactional email - OTP, welcome) ----
SMTP_ENDPOINT=https://your-smtp-endpoint/messages
SMTP_FROM="DeenDose <no-reply@deendose.app>"

# ---- Quran / Hadith source APIs ----
QURAN_API_BASE=https://api.quran.com
HADITH_API_BASE=https://api.hadith.gading.dev

# ---- Social media OAuth (one set per platform) ----
# Each platform's app is registered with its own callback URL:
# https://your-domain.com/api/admin/oauth/<platform>/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- AI multi-agent validator (optional) ----
GOOGLE_GENERATIVE_AI_API_KEY=

# ---- Cron security ----
# Random 32-byte hex string. Required for /api/cron/* routes.
CRON_SECRET=replace-with-32-byte-hex-secret

# ---- Cloudflare Pages deployment (used by the deploy script) ----
CLOUDFLARE_ACCOUNT_ID=15e9c5b50883ba36464fef9aa90937e1
CLOUDFLARE_API_TOKEN=replace-with-real-token
CLOUDFLARE_PROJECT_NAME=deendose

# ---- App config ----
NEXT_PUBLIC_APP_URL=https://deendose.pages.dev
NEXT_PUBLIC_APP_NAME=DeenDose
